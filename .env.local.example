# Minimal .env.local — copy to .env.local and add your Alchemy key.
# For the COMPLETE, documented list of every variable (gas policy, session keys,
# geo gate, analytics), see .env.example.  No secrets in git.

# [REQUIRED] Alchemy API key — RPC transport AND the Account Kit signer.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# [REQUIRED] Matcher backend (REST; WS derived). Public demo shown; if left unset
# the app silently falls back to https://dev-api.pulsepairs.com — set it.
NEXT_PUBLIC_API_BASE_URL=https://api.demo-pulsepairs.rainwins.com

# [optional, default 42161] 42161 (Arbitrum One) or 421614 (Arbitrum Sepolia).
NEXT_PUBLIC_CHAIN_ID=42161

# [recommended] Your own WalletConnect (Reown) Cloud project id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# [optional] Demo default disables the geo gate (placeholder list blocks US/GB).
NEXT_PUBLIC_RESTRICTED_COUNTRIES=NONE

# [recommended] Pin the funds-reaching addresses the backend hands us (settlement
# / verifyingContract + USDT spender). Comma-separated, any case; MUST equal the
# box's GET /config verifyingContract + USDT spender. Empty DISABLES the check.
# Values below are the LIVE demo stack (Arbitrum One). See .env.example for the
# fail-closed NEXT_PUBLIC_REQUIRE_ADDRESS_PIN switch (set it on real mainnet).
NEXT_PUBLIC_ALLOWED_SETTLEMENTS=0x3Da0Ad7fF3A746F1f70309f52F9914832b2f80DB
NEXT_PUBLIC_ALLOWED_USDT=0xCa4f77A38d8552Dd1D5E44e890173921B67725F4

# [REQUIRED against the demo] Complementary MINT/MERGE UX. The demo's market
# maker quotes BIDS ONLY, so the raw book carries no asks: a DOWN bid @ q is a
# synthetic UP ask @ (10000 - q), and crossing them mints a set. Without this
# the UI reads each column's own asks, finds none, and disables MARKET orders
# ("No liquidity") even though the demo is fully liquid. Must match the box's
# backend COMPLEMENTARY_MATCHING_ENABLED=1 — never enable it against a
# Settlement without mintMatch/mergeMatch.
NEXT_PUBLIC_COMPLEMENTARY_MATCHING=1
