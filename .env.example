# ─────────────────────────────────────────────────────────────────────────────
# updown-frontend — environment configuration
#
# Copy this file to `.env.local` and fill it in:  cp .env.example .env.local
# All browser-exposed vars are prefixed NEXT_PUBLIC_ and are BAKED IN AT BUILD
# TIME — after changing any of them you must re-run `npm run build` (a restart
# is not enough for a production build).
#
# Legend:  [REQUIRED] must be set for a real deployment · [optional] has a default
# ─────────────────────────────────────────────────────────────────────────────


# ── Backend + chain (the two you must get right) ─────────────────────────────

# [REQUIRED] Base URL of the UpDown matcher backend (REST). The WebSocket URL is
# DERIVED from this (https→wss, path → /stream); there is no separate WS var.
#
# ⚠ If you leave this unset the app does NOT error — it silently falls back to
#   https://dev-api.pulsepairs.com (a PulsePairs-operated host outside your
#   control). Always set it explicitly. Public demo backend:
NEXT_PUBLIC_API_BASE_URL=https://api.demo-pulsepairs.rainwins.com

# [optional, default 42161] Active chain. Only 42161 (Arbitrum One) and 421614
# (Arbitrum Sepolia) are wired — local hardhat / 31337 is NOT supported.
NEXT_PUBLIC_CHAIN_ID=42161

# [optional, default off] Show the "Get 100 …" faucet button (DepositModal +
# inline TradeForm CTA). Always on for Sepolia (421614). Set to 1 for the mock
# DEMO stack (Arbitrum One + publicly-mintable MockUSDT + backend NODE_ENV!=
# production, so POST /test/devmint is live). LEAVE UNSET on a real production
# build with real USDT — an unset flag keeps the faucet hidden on mainnet.
# NEXT_PUBLIC_ENABLE_FAUCET=1


# ── Address pin (the two server-supplied addresses that reach user funds) ─────
# GET /config and GET /markets are the ONLY source for the EIP-712 domain
# (verifyingContract we sign against) and for the settlement we hand to
# USDT.approve. A compromised backend that serves one crafted market key could
# make the browser sign for — or grant an allowance to — an address it chose.
# These allowlists are the client-side check that closes that (lib/pinnedAddresses).
#
# Format: comma-separated, any case. Each value MUST equal the box's
# GET /config `verifyingContract` (settlement) / the USDT spender it approves.
# Multiple entries allowed (UpDownSettlement is IMMUTABLE, so every change is a
# redeploy at a NEW address — list the old + new during a cutover).
#
# ⚠ Leaving EITHER var EMPTY DISABLES that check (warn-and-skip) — the app still
#   runs, but the highest-value control is off. See NEXT_PUBLIC_REQUIRE_ADDRESS_PIN.
#
# Values below are the LIVE demo stack (Arbitrum One, chain 42161). A real
# mainnet deploy uses the same USDT but its OWN settlement — read it from that
# box's GET /config before you trust these.
NEXT_PUBLIC_ALLOWED_SETTLEMENTS=0xBF119BC4C3C56b78E211F8fC49C8232a3a3053ed
NEXT_PUBLIC_ALLOWED_USDT=0xCa4f77A38d8552Dd1D5E44e890173921B67725F4

# [optional, default off] Fail-closed switch for the address pin. When set to 1
# (or true), an EMPTY allowlist THROWS at signing/approval time instead of
# warn-and-skip. Set this on a REAL-MONEY MAINNET build so it can never ship
# with the pin unarmed. Leave UNSET on the demo/testnet boxes: their FE is still
# a production `next build`, and NODE_ENV cannot distinguish them from mainnet,
# so this must be an explicit opt-in rather than an automatic prod check.
# NEXT_PUBLIC_REQUIRE_ADDRESS_PIN=1


# ── Wallet / smart-account infra ─────────────────────────────────────────────

# [REQUIRED] Alchemy API key. Used for the Arbitrum RPC transport AND to build
# the Account Kit smart-account signer.
#
# ⚠ Effectively required: if blank, reads silently downgrade to the rate-limited
#   public Arbitrum RPC AND the Account Kit signer constructor THROWS — so market
#   data loads but onboarding / order signing hard-fail (confusing partial state).
NEXT_PUBLIC_ALCHEMY_API_KEY=

# [optional but recommended] Your own WalletConnect (Reown) Cloud project id.
# If blank, falls back to a shared PulsePairs project id — your WalletConnect
# sessions would be attributed to PulsePairs' project (their limits/analytics,
# breaks if they ever delete it). Get one at https://cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=


# ── Gas payment mode for Account Kit UserOps (onboarding + orders) ────────────
# Presence/absence of the policy id selects the mode:
#   unset                                → SELF-PAID (the SCA must hold ETH for gas; demo default)
#   GAS_POLICY_ID set                    → SPONSORED (gasless) — requires a SPONSORSHIP-type policy
#   GAS_POLICY_ID + AK_GAS_TOKEN both set → ERC-20-paid (the SCA pays gas in that token)

# [optional] Alchemy Gas Manager policy id. NOTE: for gasless UX this must be a
# SPONSORSHIP-type policy. An ERC-20-type policy makes users pay gas in a token.
NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID=

# [optional] ERC-20 token the SCA pays gas in (only used when a gas policy is set
# AND it is ERC-20-type). Example = Arbitrum One USDC:
# NEXT_PUBLIC_AK_GAS_TOKEN=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
NEXT_PUBLIC_AK_GAS_TOKEN=


# ── Popup-less order signing (MA-v2 session keys) ────────────────────────────

# [optional, default ON] Popup-less order/cancel/WS-auth signing via a
# signature-validation-only session key installed on the SCA. Set to exactly "0"
# to disable and sign every order with an owner-wallet popup. Any runtime session
# failure auto-falls back to owner-key signing regardless of this flag.
NEXT_PUBLIC_SESSION_ORDERS=1

# [optional, default 10000000] Parsed at load (BigInt() — a non-numeric value
# throws) but currently NOT consumed by the signing/UserOp path; gas is estimated
# by Account Kit. Kept for forward-compat; safe to leave at the default.
NEXT_PUBLIC_SESSION_GAS_LIMIT=10000000

# [optional, default 10000000000] Parsed at load (BigInt()) but currently NOT
# consumed: onboarding always approves the settlement for MAX_UINT256 regardless
# of this value. Kept for forward-compat; safe to leave at the default.
NEXT_PUBLIC_SESSION_USDT_ALLOWANCE=10000000000


# ── Geo restriction ──────────────────────────────────────────────────────────

# [optional] Comma-separated ISO-3166-1 alpha-2 countries to geo-block (edge 451
# + client overlay).
#
# ⚠ If UNSET it falls back to a PLACEHOLDER list that BLOCKS US, GB, IR, KP, SY,
#   CU — this will lock out most testers. Set to NONE to disable the gate
#   entirely, or supply your own legal-approved list. Because middleware snapshots
#   this at import, changes require a rebuild.
NEXT_PUBLIC_RESTRICTED_COUNTRIES=NONE


# ── Product analytics (fully optional) ───────────────────────────────────────

# [optional] PostHog key. If blank, analytics never initialize (no-op). Analytics
# also require explicit cookie consent regardless.
NEXT_PUBLIC_POSTHOG_KEY=

# [optional, default https://us.i.posthog.com] PostHog host (set the EU host for
# EU data residency). Ignored when POSTHOG_KEY is blank.
NEXT_PUBLIC_POSTHOG_HOST=
