# ── updown-frontend — point at the Sepolia deployment ────────────────────────
# Copy to `.env.local`:  cp .env.local.sepolia.example .env.local
# The frontend is OPTIONAL for smoke load (load is driven by backend bots), but
# useful for manually QA-ing a trade through the UI against the new deployment.

# Backend REST + (derived) WebSocket host. Local backend:
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# MUST be 421614 (Arbitrum Sepolia) or 42161 (Arbitrum One). 31337 is NOT
# supported — there is no local-hardhat path in the wagmi config.
NEXT_PUBLIC_CHAIN_ID=421614

# Optional. If unset, falls back to the public Arb Sepolia RPC.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Optional. A hardcoded fallback project id is used if unset.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Pin the funds-reaching addresses (settlement / verifyingContract + USDT spender).
# Comma-separated, any case; MUST equal this box's GET /config verifyingContract
# and the USDT spender. Empty DISABLES the check.
#
# ⚠ The TESTNET (Arb Sepolia) settlement + USDT are DIFFERENT addresses from the
#   demo/mainnet stack — do NOT copy the .env.example demo values here, a WRONG
#   pin bricks trading. TODO: read the real values from THIS box and paste them:
#     curl -s http://localhost:3001/config | jq '.eip712.domain.verifyingContract'
#   (settlement) and the USDT spender the same box approves, then fill both below.
NEXT_PUBLIC_ALLOWED_SETTLEMENTS=
NEXT_PUBLIC_ALLOWED_USDT=
